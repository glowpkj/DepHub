# Local publish credentials and machine-specific tooling must never be pushed.
.publish-token
.publish-remote
tools/mingit/
*.log

# Release artifacts are built locally. Only the published bundle is committed
# (the loader fetches it from the raw URL); the rest of dist/ stays ignored.
# Note: the directory itself is not ignored, only its contents, so the negation
# below can re-include the bundle.
dist/*
!dist/DepHub.lua

# Editor / OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/
